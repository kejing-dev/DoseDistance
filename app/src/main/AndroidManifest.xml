<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network, no camera: plane detection and the head pose need no runtime permission on the
         emulator (design container.permissions; device to be confirmed, the blocked dialog covers it).
         v0.1.2: eye gaze + pinch places the source and the shields (taste profile D1), asked once. -->
    <uses-permission android:name="com.picovr.permission.EYE_TRACKING" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoseDistance"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.DoseDistance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DefaultStage: one Mixed Stage (Full Space, passthrough) holds the whole product -->
            <meta-data
                android:name="pico.spatial.stage.id"
                android:value="DoseDistanceStage" />
            <meta-data
                android:name="pico.spatial.stage.style"
                android:value="1" />
            <meta-data
                android:name="pico.spatial.stage.immersion"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.stage.immersion_min"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.stage.immersion_max"
                android:value="0" />
        </activity>

        <activity
            android:name=".platform.EyePermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.DoseDistance" />

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
